# API Keys & Secrets
.env
.env.development
.env.production
.env.example
google-services.json
GoogleService-Info.plist

# IDEs and Editors
.vscode/
.idea/

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
