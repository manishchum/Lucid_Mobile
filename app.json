{
  "expo": {
    "name": "LucidX",
    "slug": "lucid-mobile",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.workfloww.lucidmobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSSpeechRecognitionUsageDescription": "Allow LucidX to recognize your speech.",
        "NSMicrophoneUsageDescription": "Allow LucidX to access your microphone for speech recognition."
      }
    },
    "android": {
      "versionCode": 26,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.workfloww.lucidmobile",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-screen-orientation",
      "expo-image-picker",
      "@react-native-firebase/messaging",
      "expo-font",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow LucidX to access your microphone for speech recognition.",
          "speechRecognitionPermission": "Allow LucidX to recognize your speech."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "68ab546b-91aa-4103-8b23-932ae8680058"
      }
    },
    "owner": "workflowwais-team"
  }
}
